generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  body      String
  createdAt DateTime @default(now())
}

model User {
  id   String @id
  plan String @default("free")
}

model StripeEvent {
  id        String   @id
  createdAt DateTime @default(now())
}
