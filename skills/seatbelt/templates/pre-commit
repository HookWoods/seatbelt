#!/bin/sh
# Seatbelt secret check. Refuses a commit that adds a secret file or a secret key.
# It reads only the staged changes and never prints a key. Delete this file to turn it off.

fail=0
files=$(git diff --cached --name-only --diff-filter=ACMR)

# Keys that give access. Public keys (Stripe pk_, Supabase anon or publishable, Firebase web config) are not listed.
keys='sk_live_[0-9A-Za-z]{8,}|rk_live_[0-9A-Za-z]{8,}|sb_secret_[0-9A-Za-z_-]{8,}|(^|[^0-9A-Za-z_-])sk-[0-9A-Za-z_-]{20,}'
keys="$keys"'|-----BEGIN [A-Z ]*PRIVATE KEY-----|AKIA[0-9A-Z]{16}|gh[pousr]_[0-9A-Za-z]{30,}|glpat-[0-9A-Za-z_-]{20,}'
keys="$keys"'|xox[abprs]-[0-9A-Za-z-]{10,}|postgres(ql)?://[^:/[:space:]]+:[^@[:space:]]+@'
# A Supabase key whose role is service_role, in any of its three encodings.
keys="$keys"'|eyJ[0-9A-Za-z_-]*\.eyJ[0-9A-Za-z_-]*(c2VydmljZV9yb2xl|NlcnZpY2Vfcm9sZ|zZXJ2aWNlX3JvbG)'

while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in
    *.example|*.sample|*.template) continue ;;
    .env|.env.*|*/.env|*/.env.*|*.pem|*.p12|*.pfx|*.key|id_rsa*|*/id_rsa*)
      echo "Seatbelt: $f is a secret file. Add it to .gitignore and keep it out of commits."
      fail=1
      continue ;;
  esac
  if git diff --cached -U0 --no-color -- "$f" | grep '^+' | grep -v '^+++' | grep -Eq "$keys"; then
    echo "Seatbelt: $f adds what looks like a secret key. Move it to your secret variables."
    fail=1
  fi
done <<EOF
$files
EOF

if [ "$fail" -ne 0 ]; then
  echo "Seatbelt stopped this commit. Nothing was saved."
  exit 1
fi
exit 0
